{
  "name": "ariestools-skills-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "validate:skills": "node scripts/validate-skills.mjs skills",
    "validate:upstream": "node scripts/validate-skills.mjs skills --upstream",
    "sync:claude": "node scripts/marketplace-sync/build-claude.mjs",
    "sync:codex": "node scripts/marketplace-sync/build-codex.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "error",
      "version": ">=26.0.0 <27.0.0"
    },
    "packageManager": {
      "name": "pnpm",
      "onFail": "error",
      "version": ">=12.16.0 <13.0.0"
    }
  }
}
